# The clickable prototype needs no environment variables.
# These are placeholders for the server work described in the README. Never commit real values.

# PostgreSQL connection string (production). Local development will use embedded Postgres (PGlite).
# DATABASE_URL=postgresql://user:password@host:5432/plus1

# SMS provider for phone verification, recovery and door codes.
# SMS_PROVIDER=mock
# SMS_API_KEY=
# SMS_WEBHOOK_SECRET=

# OCR provider for the scanned-ID age check.
# OCR_PROVIDER=mock
# OCR_API_KEY=

# Session signing secret.
# SESSION_SECRET=
